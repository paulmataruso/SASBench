# SASBench deployment settings. Copy to .env next to docker-compose.yml and uncomment what you
# need:   cp .env.example .env
# After a change run `docker compose up -d` again: it recreates the container with the new values
# (`docker compose restart` does not re-read .env).
# Running without Docker? Export the same variables before `npm start`.
# A variable left empty (NAME=) counts as not set.

# ---------------------------------------------------------------- addressing

# The FQDN or IP address radios use to reach the SAS. It becomes the common name and first
# subject alternative name of the auto-generated SAS server certificates (they are reissued on the
# next start when it is missing), and the Overview shows the SAS endpoints with this name.
# SAS_FQDN=sas.lab.example.com

# The IP address every listener binds: web UI, REST API, SAS HTTP and SAS HTTPS. Default: all
# addresses (0.0.0.0). Must be an address of this machine. The Overview shows it next to SAS_FQDN;
# when it is not set, the Overview shows the machine's main address instead.
# SAS_BIND_IP=192.168.10.5

# More names or addresses for the server certificate, comma-separated (a NAT address, a DNS alias).
# The machine's own interface addresses are always included.
# SAS_HOSTNAMES=sas.lab.local,203.0.113.10

# ---------------------------------------------------------------- ports
# With host networking (the default compose file) these are the ports on the host. After changing
# one, apply it with docker compose up -d (docker restart does not re-read this file).

# Web UI and its REST API (the public REST API is served here too, under /api/v1).
# UI_PORT=8080
# A separate port that serves only the public REST API (/api/v1), e.g. to firewall it apart from
# the web UI. Default: not set (the API is on UI_PORT only).
# SAS_API_PORT=8081
# The ports radios connect to: the SAS-CBSD protocol over plain HTTP, and over HTTPS / mutual TLS
# (WINNF-TS-0065). Any free port works, including 80 and 443 for radios that expect a SAS URL
# without a port (https://sas.lab.example/v1.2/). While set, they replace the ports in Settings,
# which can then not be changed there.
# SAS_HTTP_PORT=8000
# SAS_HTTPS_PORT=8443

# ---------------------------------------------------------------- settings profile

# Settings profile to start with: lab | winnforum | open. Applied on the first start and again
# whenever this value changes; changes made in Settings afterwards are kept across restarts.
# SAS_PROFILE=lab
# Set to "always" to re-apply SAS_PROFILE on every start (Settings changes to the profile's
# settings are then undone at each restart).
# SAS_PROFILE_APPLY=always

# ---------------------------------------------------------------- sign-in

# Password of the "admin" account created on the first start (default: admin, and the console
# asks you to change it). Read only on that first start: later changes are made in the console
# (account menu → Your account, or the Users page), or on the host with
#   docker exec sasbench node server/src/tools/reset-password.ts admin
# SAS_ADMIN_PASSWORD=a-long-passphrase

# Set to "off" to switch sign-in off: anyone who can reach the web UI or the REST API gets full
# admin access. Only for an isolated bench. The SAS protocol ports never ask for sign-in.
# SAS_AUTH=off

# ---------------------------------------------------------------- REST API

# Browser origins allowed to call the REST API from another site (scripts need nothing).
# Comma-separated, or * for any.
# SAS_API_CORS_ORIGINS=http://dashboard.lab:3000

# ---------------------------------------------------------------- data

# Elevation tiles for the Category A HAAT check (default /data/terrain in the container): USGS
# GeoTIFF or NED GridFloat. Fetch with
#   docker exec sasbench node server/src/tools/fetch-terrain.ts --around LAT,LON
# SAS_TERRAIN_DIR=/data/terrain
# Offline map tile store: MBTiles files and z/x/y folders (default /data/tiles).
# SAS_TILES_DIR=/data/tiles
