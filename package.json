{
  "name": "sasbench",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "WInnForum-compliant CBRS Spectrum Access System for lab testing of CBSDs and Domain Proxies",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/src/index.ts",
    "dev": "SAS_DATA_DIR=./data node --watch server/src/index.ts",
    "typecheck": "tsc -p server/tsconfig.json",
    "test": "node --test --test-concurrency=1 server/test/*.test.ts",
    "build:web": "npm --prefix web run build",
    "basemap": "scripts/build-basemap.sh",
    "terrain": "node server/src/tools/fetch-terrain.ts",
    "notices": "node scripts/third-party-notices.mjs",
    "notices:check": "node scripts/third-party-notices.mjs --check",
    "api:docs": "node scripts/api-reference.mjs",
    "api:examples": "node scripts/api-examples.mjs",
    "api:docs:check": "node scripts/api-reference.mjs --check",
    "api:coverage": "node scripts/api-coverage.mjs"
  },
  "dependencies": {
    "fflate": "0.8.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
