  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Strongest action in a toolbar or dialog; rail-black face.",
      "html": "<button class=\"ds-btn ds-btn-primary\">Issue certificate</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:6px;height:32px;padding:0 12px;border:1px solid;border-radius:3px;font:500 13.5px/20px Barlow,system-ui,sans-serif;cursor:pointer;transition:background-color 150ms,border-color 150ms,color 150ms}.ds-btn:focus-visible{outline:2px solid rgb(var(--sel));outline-offset:1px}.ds-btn-primary{background:rgb(var(--primary));color:rgb(var(--primary-fg));border-color:rgb(var(--primary))}.ds-btn-primary:hover{background:rgb(var(--primary-hover));border-color:rgb(var(--primary-hover))}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Default button: panel face with strong hairline.",
      "html": "<button class=\"ds-btn2\">Cancel</button>",
      "css": ".ds-btn2{display:inline-flex;align-items:center;height:32px;padding:0 12px;background:rgb(var(--panel));color:rgb(var(--ink));border:1px solid rgb(var(--line-strong));border-radius:3px;font:500 13.5px/20px Barlow,system-ui,sans-serif;cursor:pointer;transition:background-color 150ms,border-color 150ms}.ds-btn2:hover{border-color:rgb(var(--ink-3));background:rgb(var(--panel-2))}.ds-btn2:active{background:rgb(var(--panel-3))}.ds-btn2:focus-visible{outline:2px solid rgb(var(--sel));outline-offset:1px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Toolbar and copy actions.",
      "html": "<button class=\"ds-btn-ghost\" aria-label=\"Copy\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect width=\"14\" height=\"14\" x=\"8\" y=\"8\" rx=\"2\"/><path d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\"/></svg></button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;background:transparent;color:rgb(var(--ink-2));border:1px solid transparent;border-radius:3px;cursor:pointer;transition:background-color 150ms,color 150ms}.ds-btn-ghost:hover{background:rgb(var(--panel-3));color:rgb(var(--ink))}.ds-btn-ghost:focus-visible{outline:2px solid rgb(var(--sel));outline-offset:1px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "All inputs, selects and textareas share the field style.",
      "html": "<label class=\"ds-label\">FCC ID<input class=\"ds-field\" value=\"ABC123\"></label>",
      "css": ".ds-label{display:block;font:500 12.5px/18px Barlow,system-ui,sans-serif;color:rgb(var(--ink-2))}.ds-field{display:block;width:100%;margin-top:4px;padding:5px 8px;background:rgb(var(--panel));color:rgb(var(--ink));border:1px solid rgb(var(--line-strong));border-radius:3px;font:400 13.5px/20px Barlow,system-ui,sans-serif;transition:border-color 150ms}.ds-field:hover:not(:focus){border-color:rgb(var(--ink-3))}.ds-field:focus{outline:none;border-color:rgb(var(--sel));box-shadow:0 0 0 3px rgb(var(--sel) / 0.18)}"
    },
    {
      "name": "Rail Navigation",
      "kind": "nav",
      "refersTo": "rail-nav-item",
      "description": "Anodized rail with silkscreen group labels and 32px items.",
      "html": "<nav class=\"ds-rail\"><div class=\"ds-rail-group\">Operate</div><a class=\"ds-rail-item ds-active\" href=\"#\">Overview</a><a class=\"ds-rail-item\" href=\"#\">CBSDs<span class=\"ds-rail-badge\">4</span></a><a class=\"ds-rail-item\" href=\"#\">Grants</a></nav>",
      "css": ".ds-rail{width:216px;padding:8px;background:rgb(var(--rail));color:rgb(var(--rail-fg))}.ds-rail-group{padding:8px 10px 4px;font:600 10.5px/14px 'Barlow Condensed',Barlow,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:rgb(var(--rail-mute))}.ds-rail-item{display:flex;align-items:center;height:32px;padding:0 10px;border-radius:3px;font:400 13.5px/20px Barlow,sans-serif;color:rgb(var(--rail-fg) / .8);text-decoration:none;transition:background-color 150ms,color 150ms}.ds-rail-item:hover{background:rgb(var(--rail-2));color:#fff}.ds-rail-item.ds-active{background:rgb(var(--rail-3));color:#fff}.ds-rail-item:focus-visible{outline:2px solid rgb(var(--sel));outline-offset:1px}.ds-rail-badge{margin-left:auto;font-size:11.5px;font-variant-numeric:tabular-nums;color:rgb(var(--rail-mute))}"
    },
    {
      "name": "Status Tags",
      "kind": "chip",
      "refersTo": "tag",
      "description": "Grant-state and response-code tags in the LED vocabulary.",
      "html": "<span class=\"ds-tag ds-ok\">AUTHORIZED</span> <span class=\"ds-tag ds-warn\">GRANTED · SUSPENDED</span> <span class=\"ds-tag ds-bad ds-mono\">103</span> <span class=\"ds-tag\">CAT A</span>",
      "css": ".ds-tag{display:inline-flex;align-items:center;height:20px;padding:0 6px;border:1px solid rgb(var(--line-strong));border-radius:2px;background:rgb(var(--panel-3));color:rgb(var(--ink-2));font:500 11.5px/16px 'Barlow Condensed',Barlow,sans-serif;letter-spacing:.04em}.ds-ok{background:rgb(var(--ok-soft));color:rgb(var(--ok-ink));border-color:rgb(var(--ok) / .3)}.ds-warn{background:rgb(var(--warn-soft));color:rgb(var(--warn-ink));border-color:rgb(var(--warn) / .4)}.ds-bad{background:rgb(var(--bad-soft));color:rgb(var(--bad-ink));border-color:rgb(var(--bad) / .3)}.ds-mono{font:500 10.5px/14px 'JetBrains Mono',monospace;letter-spacing:0}"
    },
    {
      "name": "Module",
      "kind": "card",
      "refersTo": "module",
      "description": "Rack module: flat panel face, hairline border, silkscreen header strip.",
      "html": "<section class=\"ds-module\"><header class=\"ds-module-h\"><h2>Point radios at</h2><span class=\"ds-meta\">2 listeners</span></header><div class=\"ds-module-b\"><code>https://lab-sas:8443/v1.2/</code></div></section>",
      "css": ".ds-module{background:rgb(var(--panel));border:1px solid rgb(var(--line));border-radius:3px;box-shadow:0 1px 2px rgb(var(--shadow) / .06),0 1px 1px rgb(var(--shadow) / .04)}.ds-module-h{display:flex;align-items:center;gap:12px;min-height:34px;padding:4px 12px;background:rgb(var(--panel-2));border-bottom:1px solid rgb(var(--line))}.ds-module-h h2{margin:0;font:600 11.5px/16px 'Barlow Condensed',Barlow,sans-serif;letter-spacing:.09em;text-transform:uppercase;color:rgb(var(--ink-2))}.ds-meta{font:400 11.5px/16px Barlow,sans-serif;color:rgb(var(--ink-3))}.ds-module-b{padding:12px;font:400 12.5px/18px 'JetBrains Mono',monospace;color:rgb(var(--ink))}"
    },
    {
      "name": "CBSD Rack Row",
      "kind": "custom",
      "refersTo": "table-row",
      "description": "Signature 1U row: patch swatch, REG/GNT/HB LEDs, TX drain bar, mono identity.",
      "html": "<div class=\"ds-row\"><span class=\"ds-sw\"></span><span class=\"ds-leds\"><span class=\"ds-led ds-lok\"></span><span class=\"ds-led ds-lok\"></span><span class=\"ds-led ds-lok ds-flash\"></span></span><span class=\"ds-tx\"><span class=\"ds-led ds-lok\"></span><span class=\"ds-track\"><span class=\"ds-fill\"></span></span><span class=\"ds-t\">3m 12s</span></span><span class=\"ds-id\">FCCABC / SN-0042</span><span class=\"ds-rng\">3550.0–3560.0</span></div>",
      "css": ".ds-row{display:flex;align-items:center;gap:16px;height:36px;padding:0 12px;background:rgb(var(--panel));border-bottom:1px solid rgb(var(--line));transition:background-color 100ms}.ds-row:hover{background:rgb(var(--panel-3) / .7)}.ds-sw{width:10px;height:10px;border-radius:2px;background:rgb(var(--p2))}.ds-leds{display:inline-flex;gap:19px}.ds-led{display:inline-block;width:8px;height:8px;border-radius:9999px;background:rgb(var(--led-off));box-shadow:inset 0 0 0 1px rgb(var(--shadow) / .12)}.ds-lok{background:rgb(var(--ok));box-shadow:0 0 5px rgb(var(--ok) / .55)}.ds-flash{animation:ds-flash 900ms cubic-bezier(.16,1,.3,1) infinite 1.5s}@keyframes ds-flash{0%{background:#fff;box-shadow:0 0 0 2px rgb(var(--ok) / .55),0 0 12px 2px rgb(var(--ok) / .9)}35%{background:rgb(var(--ok));box-shadow:0 0 9px 1px rgb(var(--ok) / .8)}}.ds-tx{display:inline-flex;align-items:center;gap:6px}.ds-track{position:relative;width:40px;height:3px;border-radius:9999px;background:rgb(var(--line));overflow:hidden}.ds-fill{position:absolute;inset:0 auto 0 0;width:64%;background:rgb(var(--ok));border-radius:9999px}.ds-t{width:46px;font:400 10.5px/14px 'JetBrains Mono',monospace;color:rgb(var(--ink-3));font-variant-numeric:tabular-nums}.ds-id{font:500 11.5px/16px 'JetBrains Mono',monospace;color:rgb(var(--ink))}.ds-rng{font:400 11.5px/16px 'JetBrains Mono',monospace;color:rgb(var(--ink));font-variant-numeric:tabular-nums}@media (prefers-reduced-motion:reduce){.ds-flash{animation:none}}"
    }
  ],
  "narrative": {
    "northStar": "The Lab Rack Elevation",
    "overview": "**Creative North Star: \"The Lab Rack Elevation\"**\n\nThe console is drawn as a front elevation of an equipment rack. A cool blue-black anodized rail runs down the left edge and carries navigation and listener status; the working area is an aluminium-tinted ground on which flat white panel faces sit, each ruled by hairlines and topped by a silkscreened header strip. Every radio (CBSD) is a single dense row in that rack, and its state is read from small front-panel LEDs that change as wire events arrive over SSE, not from cards, KPIs or charts.\n\nDensity is high and deliberate: a 13.5px body, 36px table rows, 12px module padding, 16px gutters. The type system splits three ways: Barlow for interface text, Barlow Condensed in tracked caps for the printed legends, and JetBrains Mono with slashed zero and tabular figures for every identifier, timer, frequency and JSON payload. Colour is functional: neutrals for the hardware, a four-state LED vocabulary for status, one blue for selection and focus, and an eight-colour patch-cable code that gives each CBSD a single identity colour reused across the rack, band plan and map.\n\nThe material is flat. There are no screws, brushed textures, bezels or skeuomorphic depth; the only glow in the system belongs to a lit LED. Light and dark themes are both first-class and follow `prefers-color-scheme` unless overridden with `data-theme`.",
    "keyCharacteristics": [
      "Dark rail plus light panels: the hardware frame and the faces it holds.",
      "Silkscreen legends (condensed, tracked caps) label modules, table heads and readout keys.",
      "8px flat LEDs as the main status signal; a soft glow only while lit.",
      "Patch-cable identity colour per CBSD, shared across every view.",
      "Mono with tabular figures for all machine values.",
      "Hairline borders and tonal panel steps; near-zero shadow."
    ],
    "rules": [
      {
        "name": "The LED Vocabulary Rule",
        "body": "Status colour means exactly one thing everywhere: green authorized/ok, amber pending/suspended, red terminated/error, blue granted-not-transmitting, grey off. Don't reuse these hues for decoration or emphasis.",
        "section": "colors"
      },
      {
        "name": "The One Cable Per Radio Rule",
        "body": "A CBSD's patch colour is its identity across every page. Use `patchColor(cbsdId)`; never assign patch colours by list position or reuse them for anything that is not a CBSD.",
        "section": "colors"
      },
      {
        "name": "The Selection Is Not Status Rule",
        "body": "Blue `sel` marks focus, selection and links only. A GRANTED grant uses `info`, which is a different token even though the hue is close.",
        "section": "colors"
      },
      {
        "name": "The Silkscreen Legend Rule",
        "body": "Condensed tracked caps label a thing that sits right below or beside them: a module, a column, a readout value, a block of data. They are legends, not decoration.",
        "section": "typography"
      },
      {
        "name": "The Machine Values Are Mono Rule",
        "body": "Anything a radio sent or a spec defines (IDs, codes, frequencies, EIRP, timers, URLs, payloads) is set in JetBrains Mono with tabular figures, so columns line up and zeros can't be read as O.",
        "section": "typography"
      },
      {
        "name": "The 1U Rhythm Rule",
        "body": "Rows are 36px, controls are 32px (28px small), header strips are 34px. New dense lists use the same heights so the rack keeps one cadence.",
        "section": "layout"
      },
      {
        "name": "The Flat Faces Rule",
        "body": "Panels are flat at rest. Only floating layers (drawer, dialog, toast, popup) use the pop shadow, and only a lit LED glows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do show live state with 8px LEDs in the fixed vocabulary (ok / warn / bad / info / off), and keep the glow to lit LEDs only.",
      "Do mark every CBSD with its patch-cable colour from `patchColor(cbsdId)`, wherever it appears (rack swatch, band blocks, map).",
      "Do label modules, table columns and readout keys with silkscreen legends (Barlow Condensed, 10.5px, 600, uppercase, 0.09em).",
      "Do set IDs, codes, frequencies, timers, URLs and JSON in JetBrains Mono with tabular figures.",
      "Do build new surfaces from modules: panel face, 1px line border, 3px corners, a 34px panel-2 header strip, 12px body padding.",
      "Do keep to the 1U rhythm: 36px rows, 32px controls, 16px gutters between modules.",
      "Do define any new colour as an RGB triplet on `:root` with a dark-theme value, and consume it through the Tailwind role names.",
      "Do honour `prefers-reduced-motion`: flashes collapse and slide or scale entrances are removed."
    ],
    "donts": [
      "Don't add KPI stat cards, hero numbers or charts that duplicate what the rack and band strip already show.",
      "Don't dress the rack up as hardware. No screws, brushed metal, bezels, decorative gradients or 3D LEDs; faces stay flat. The only gradients allowed are functional: the diagonal hatch on suspended spectrum and the skeleton shimmer.",
      "Don't use status hues (ok, warn, bad, info) or patch colours for decoration, or use sel blue to signal status.",
      "Don't put a shadow on a resting panel beyond panel contact; the pop shadow belongs to floating layers only.",
      "Don't round containers past 6px; circles are reserved for LEDs, marks, switches and drain tracks.",
      "Don't set font sizes off the px ramp or hard-code colours outside the token set."
    ]
  }
}